#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG="@izantech/lineup-cli"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
BOLD=$'\033[1m'
NC=$'\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }

ensure_cli_deps() {
    if [[ ! -d "$ROOT_DIR/cli/node_modules" ]]; then
        echo -e "${BOLD}CLI dependencies missing. Installing...${NC}"
        npm --prefix "$ROOT_DIR/cli" install
    fi
}

ensure_site_deps() {
    if [[ ! -d "$ROOT_DIR/site/node_modules" ]]; then
        echo -e "${BOLD}Site dependencies missing. Installing...${NC}"
        npm --prefix "$ROOT_DIR/site" install
    fi
}

usage() {
    cat <<EOF
${GREEN}${BOLD}Lineup Dev Script${NC}

Usage: ./dev <command> [args...]

${GREEN}Install:${NC}
  install local [--host <host>|all]   Build from source and install CLI + detected host skills
  install remote [--host <host>|all]  Install latest version from npm
  install clean           Remove CLI and host skills
  install clean --purge   Also remove custom agent config and memory

${GREEN}Build:${NC}
  build                   Build CLI
  typecheck               Run TypeScript type checks
  test                    Run test suite
  check                   Run all checks (typecheck, test, schema, generate, build)
  tui [args...]           Launch the local-source TUI without installing lineup globally

${GREEN}Web:${NC}
  web                     Start Astro dev server
  web build               Build site for production
  web preview             Preview production site build

${GREEN}Benchmark:${NC}
  bench                   Run benchmark (all defaults)
  bench --agent <name>    Run with specific agent (claude, codex, opencode)
  bench --auto-models     Use recommended models per complexity
  bench [...]             Any flag from scripts/benchmark-ollama.py
  bench clean             Remove all benchmark results

${GREEN}Clean:${NC}
  clean                   Remove all generated artifacts (build, benchmark, cache)
  clean --dry-run         Show what would be removed
  bench clean             Remove only benchmark results

${GREEN}Other:${NC}
  setup                   Install dependencies
  help                    Show this help message
EOF
}

collect_install_hosts() {
    local requested="${1:-available}"
    local hosts=()

    case "$requested" in
        all)
            hosts=(claude codex opencode)
            ;;
        claude|codex|opencode)
            hosts=("$requested")
            ;;
        available|"")
            command -v claude >/dev/null 2>&1 && hosts+=(claude)
            command -v codex >/dev/null 2>&1 && hosts+=(codex)
            command -v opencode >/dev/null 2>&1 && hosts+=(opencode)
            ;;
        *)
            die "unknown host '$requested' — use claude, codex, opencode, or all"
            ;;
    esac

    printf '%s\n' "${hosts[@]}"
}

install_selected_hosts() {
    local mode="$1"
    local root_flag=()
    local requested_host="${2:-available}"
    local hosts=()

    while IFS= read -r host; do
        [[ -n "$host" ]] && hosts+=("$host")
    done < <(collect_install_hosts "$requested_host")

    if [[ "$mode" == "local" ]]; then
        root_flag=(--from-dir "$ROOT_DIR")
    fi

    if [[ ${#hosts[@]} -eq 0 ]]; then
        echo -e "${BOLD}No supported host commands detected. Skipping host skill installation.${NC}"
        return
    fi

    echo -e "${BOLD}Installing host skills for:${NC} ${hosts[*]}"
    for host in "${hosts[@]}"; do
        lineup install --host "$host" "${root_flag[@]}" --yes
    done
}

install_local() {
    local requested_host="${1:-available}"
    echo -e "${BOLD}Uninstalling remote CLI (keeping config)...${NC}"
    npm uninstall -g "$PKG" 2>/dev/null || true
    lineup uninstall --host all --yes 2>/dev/null || true

    ensure_cli_deps
    echo -e "${BOLD}Building CLI from source...${NC}"
    npm --prefix "$ROOT_DIR/cli" run build

    echo -e "${BOLD}Installing CLI globally from local build...${NC}"
    npm install -g "$ROOT_DIR/cli"

    install_selected_hosts local "$requested_host"

    echo -e "\n${GREEN}Done (local). Version: $(lineup --cli-version)${NC}"
}

install_remote() {
    local requested_host="${1:-available}"
    echo -e "${BOLD}Uninstalling local CLI (keeping config)...${NC}"
    npm uninstall -g "$PKG" 2>/dev/null || true
    lineup uninstall --host all --yes 2>/dev/null || true

    echo -e "${BOLD}Installing latest CLI from npm...${NC}"
    npm install -g "$PKG@latest"

    install_selected_hosts remote "$requested_host"

    echo -e "\n${GREEN}Done (remote). Version: $(lineup --cli-version)${NC}"
}

install_clean() {
    local purge_flag=""
    [[ "${1:-}" == "--purge" ]] && purge_flag="--purge"

    echo -e "${BOLD}Uninstalling host skills${purge_flag:+ and purging config}...${NC}"
    lineup uninstall --host all --yes $purge_flag 2>/dev/null || true

    echo -e "${BOLD}Uninstalling CLI...${NC}"
    npm uninstall -g "$PKG" 2>/dev/null || true

    echo -e "\n${GREEN}Done (clean).${NC}"
}

run_build() {
    ensure_cli_deps
    echo -e "${BOLD}Building CLI...${NC}"
    npm --prefix "$ROOT_DIR/cli" run build
    echo -e "${GREEN}done${NC}"
}

run_typecheck() {
    ensure_cli_deps
    echo -e "${BOLD}Running typecheck...${NC}"
    npm --prefix "$ROOT_DIR/cli" run typecheck
    echo -e "${GREEN}done${NC}"
}

run_test() {
    ensure_cli_deps
    echo -e "${BOLD}Running tests...${NC}"
    npm --prefix "$ROOT_DIR/cli" test
    echo -e "${GREEN}done${NC}"
}

run_check() {
    ensure_cli_deps
    echo -e "${BOLD}Running all checks...${NC}\n"
    npm --prefix "$ROOT_DIR/cli" run typecheck
    npm --prefix "$ROOT_DIR/cli" test
    npm --prefix "$ROOT_DIR/cli" run schema:check
    npm --prefix "$ROOT_DIR/cli" run generate:check
    npm --prefix "$ROOT_DIR/cli" run build
    echo -e "\n${GREEN}All checks passed${NC}"
}

run_tui() {
    ensure_cli_deps
    npm --prefix "$ROOT_DIR/cli" run dev -- tui --cwd "$PWD" "$@"
}

run_setup() {
    echo -e "${BOLD}Installing CLI dependencies...${NC}"
    npm --prefix "$ROOT_DIR/cli" install
    echo -e "${BOLD}Installing site dependencies...${NC}"
    npm --prefix "$ROOT_DIR/site" install
    echo -e "\n${GREEN}Setup complete${NC}"
}

run_clean() {
    local dry_run=false
    [[ "${1:-}" == "--dry-run" ]] && dry_run=true

    local dirs=(
        "$ROOT_DIR/cli/dist"
        "$ROOT_DIR/cli/node_modules"
        "$ROOT_DIR/site/node_modules"
        "$ROOT_DIR/site/.astro"
        "$ROOT_DIR/site/dist"
        "$ROOT_DIR/.lineup/.benchmark"
        "$ROOT_DIR/.lineup/.ephemeral"
        "$ROOT_DIR/.lineup/.cache"
        "$ROOT_DIR/.runner-output"
    )

    for dir in "${dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            local size
            size="$(du -sh "$dir" 2>/dev/null | cut -f1)"
            if $dry_run; then
                echo "  would remove $dir ($size)"
            else
                echo "  removing $dir ($size)"
                rm -rf "$dir"
            fi
        fi
    done

    if $dry_run; then
        echo -e "\n${BOLD}Dry run — nothing removed.${NC}"
    else
        echo -e "${GREEN}done${NC}"
    fi
}

run_web() {
    local subcmd="${1:-dev}"
    ensure_site_deps
    if [[ "$subcmd" != "build" ]]; then
        npm --prefix "$ROOT_DIR/site" run diagrams:build
    fi
    case "$subcmd" in
        dev)     npm --prefix "$ROOT_DIR/site" run dev ;;
        build)   npm --prefix "$ROOT_DIR/site" run build ;;
        preview) npm --prefix "$ROOT_DIR/site" run preview ;;
        *)       die "unknown web command '$subcmd' — use dev, build, or preview" ;;
    esac
}

main() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        install)
            local subcmd="${1:-}"
            shift || true
            case "$subcmd" in
                local|remote)
                    local install_host="available"
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --host)
                                [[ $# -ge 2 ]] || die "--host requires a value"
                                install_host="$2"
                                shift 2
                                ;;
                            *)
                                die "unknown install option '$1' — use --host <host>|all"
                                ;;
                        esac
                    done

                    if [[ "$subcmd" == "local" ]]; then
                        install_local "$install_host"
                    else
                        install_remote "$install_host"
                    fi
                    ;;
                clean)  install_clean "$@" ;;
                *)      die "unknown install command '$subcmd' — use local, remote, or clean" ;;
            esac
            ;;
        build)     run_build ;;
        typecheck) run_typecheck ;;
        test)      run_test ;;
        check)     run_check ;;
        tui)       run_tui "$@" ;;
        web)       run_web "$@" ;;
        clean)     run_clean "$@" ;;
        bench)
            if [[ "${1:-}" == "clean" ]]; then
                echo -e "${BOLD}Removing benchmark results...${NC}"
                rm -rf "$ROOT_DIR/.lineup/.benchmark"
                echo -e "${GREEN}done${NC}"
            else
                python3 "$ROOT_DIR/scripts/benchmark-ollama.py" "$@"
            fi
            ;;
        setup)     run_setup ;;
        help)      usage ;;
        *)         die "unknown command '$command' — run ./dev help" ;;
    esac
}

main "$@"
