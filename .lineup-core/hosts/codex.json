{
  "host": "codex",
  "vars": {
    "SKILL_NAME_KICKOFF": "lineup-kick-off",
    "SKILL_NAME_CONFIGURE": "lineup-configure",
    "SKILL_NAME_EXPLAIN": "lineup-explain",
    "SKILL_NAME_PLAYBOOK": "lineup-playbook",
    "SKILL_NAME_DIGEST": "lineup-digest",
    "CMD_KICKOFF": "$lineup-kick-off",
    "CMD_CONFIGURE": "$lineup-configure",
    "CMD_EXPLAIN": "$lineup-explain",
    "CMD_PLAYBOOK": "$lineup-playbook",
    "CMD_DIGEST": "$lineup-digest",
    "KICKOFF_INIT_PATH": "~/.codex/skills/lineup-kick-off/INIT.md",
    "QUESTION_PRIMITIVE": "structured multiple-choice prompts",
    "OVERRIDES_DIR": "~/.codex/lineup/agents/",
    "MEMORY_USER_DIR": "~/.codex/lineup/memory/user",
    "MEMORY_PROJECT_DIR": "~/.codex/lineup/memory/projects",
    "HOST_TERM_PLUGIN": "skill pack",
    "HOST_TERM_PLUGIN_POSSESSIVE": "skill pack's",
    "HOST_DEFAULTS_TERM": "skill pack defaults",
    "HOST_ARTIFACT_LABEL": "Skill Pack",
    "HOST_ARTIFACT_LABEL_LOWER": "skill pack",
    "AGENTS_DIR": "agents/",
    "OLLAMA_CONFIG_PATH": "~/.codex/lineup/ollama.yaml",
    "AGENT_ID_PATTERN": "lineup-<role>",
    "SPAWN_PRIMITIVE": "Spawn the lineup-<role> subagent with this directive: \"<task-specific prompt>\".\n\nNote on Codex: this is a natural-language directive, not a tool call. Codex routes the directive to ~/.codex/agents/lineup-<role>.toml and runs the subagent in a parallel thread, returning consolidated output.",
    "PROJECT_PATH_ENCODING_NOTE": "Codex stores project memory under {{MEMORY_PROJECT_DIR}}/<project-name>/ — no path encoding required.",
    "OLLAMA_MCP_REGISTER_HINT": "see Codex MCP config docs (~/.codex/config.toml [mcp_servers.ollama])",
    "HOST_CAVEAT_NOTE": ""
  }
}
