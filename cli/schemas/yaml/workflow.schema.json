{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineup.izantech.app/schemas/yaml/workflow.schema.json",
  "title": "Lineup Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "stages"],
  "properties": {
    "apiVersion": { "const": "lineup/v1" },
    "kind": { "const": "Workflow" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": { "type": "string" },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "snapshots": { "$ref": "#/$defs/snapshotConfig" },
    "cache": { "$ref": "#/$defs/cacheConfig" },
    "lifecycle": { "$ref": "#/$defs/lifecycleConfig" }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["string", "number", "boolean"] },
        "default": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "enum": ["builtin", "reasoning", "agent", "approval"]
        },
        "description": { "type": "string" },
        "agent": {
          "type": "string",
          "enum": ["researcher", "architect", "developer", "reviewer", "documenter", "teacher"]
        },
        "parallel": { "$ref": "#/$defs/parallel" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputRef" }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": true
        },
        "condition": { "type": "string" },
        "skip_if": { "type": "string" },
        "timeout": { "type": "string" },
        "retry": { "$ref": "#/$defs/retry" },
        "on_failure": { "$ref": "#/$defs/onFailure" },
        "optional": { "type": "boolean" },
        "gate": { "type": ["string", "boolean"] }
      },
      "if": {
        "properties": { "type": { "const": "agent" } },
        "required": ["type"]
      },
      "then": {
        "required": ["agent"],
        "properties": { "agent": {} }
      },
      "else": {
        "if": {
          "properties": { "type": { "const": "approval" } },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "agent": false,
            "outputs": false
          }
        }
      }
    },
    "inputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fields"],
      "properties": {
        "source": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "via": { "type": "string", "enum": ["inline", "file-reference"] },
        "fallback": { "type": "string" }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["per-area"] },
        "max": { "type": "integer", "minimum": 1 },
        "condition": { "type": "string" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer" },
        "on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "backoff": { "type": "string", "enum": ["exponential", "linear", "none"] }
      }
    },
    "onFailure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "enum": ["report", "retry-from"] },
        "stage": { "type": "string" },
        "max_retries": { "type": "integer" },
        "block_dependents": { "type": "boolean" }
      }
    },
    "snapshotConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_size": { "type": "string" },
        "overflow": { "type": "string", "enum": ["file-reference", "truncate"] },
        "stream_threshold": { "type": "string" },
        "compression": { "type": "string", "enum": ["hybrid", "mechanical", "llm"] }
      }
    },
    "cacheConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string" },
        "key": { "type": "string" },
        "format": { "type": "string", "enum": ["yaml", "json"] }
      }
    },
    "lifecycleConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ephemeral_dir": { "type": "string" },
        "cleanup": { "type": "string", "enum": ["after_verify", "after_document", "manual"] },
        "persist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
