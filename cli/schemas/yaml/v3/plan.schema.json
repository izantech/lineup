{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineup.izantech.app/schemas/yaml/v3/plan.schema.json",
  "title": "Lineup v3 Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "status", "summary", "approaches", "recommendation", "changes", "acceptance_criteria", "risks"],
  "properties": {
    "apiVersion": {
      "const": "lineup/v3"
    },
    "kind": {
      "const": "Plan"
    },
    "type": {
      "type": "string",
      "const": "plan"
    },
    "agent": {
      "type": "string",
      "const": "architect"
    },
    "date": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "superseded"]
    },
    "pipeline_stage": {
      "type": ["integer", "null"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "approaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "strategy"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files_changed": {
                "type": "integer",
                "minimum": 0
              },
              "lines_changed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approach", "rationale"],
      "properties": {
        "approach": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "change", "rationale"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "parallelization_strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["batch_number", "execution", "changes", "rationale"],
            "properties": {
              "batch_number": {
                "type": "integer",
                "minimum": 1
              },
              "execution": {
                "type": "string",
                "enum": ["parallel", "serial"]
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "default_recommendation": {
          "type": "string",
          "enum": ["parallel", "serial"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_change", "to_change", "description"],
        "properties": {
          "from_change": {
            "type": "integer",
            "minimum": 1
          },
          "to_change": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "verified_by": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "mitigation"],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        }
      }
    }
  }
}
