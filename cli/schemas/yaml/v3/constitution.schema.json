{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineup.izantech.app/schemas/yaml/v3/constitution.schema.json",
  "title": "Lineup v3 Constitution",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "request", "repository", "scope"],
  "properties": {
    "apiVersion": {
      "const": "lineup/v3"
    },
    "kind": {
      "const": "Constitution"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string"
        },
        "git_tree_sha": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
