{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineup.izantech.app/schemas/yaml/v3/spec.schema.json",
  "title": "Lineup v3 Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "what_found", "how_it_works", "constraints", "gaps"],
  "properties": {
    "apiVersion": {
      "const": "lineup/v3"
    },
    "kind": {
      "const": "Spec"
    },
    "what_found": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "description"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "file", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "data_structures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "description"],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "how_it_works": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_flow", "data_flow", "architectural_patterns"],
      "properties": {
        "execution_flow": {
          "type": "string",
          "minLength": 1
        },
        "data_flow": {
          "type": "string",
          "minLength": 1
        },
        "architectural_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "description"],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "limitations", "edge_cases"],
      "properties": {
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "external": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "internal": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "edge_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition", "behavior"],
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "behavior": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unable_to_determine", "needs_investigation"],
      "properties": {
        "unable_to_determine": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "needs_investigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "context"],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
