{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineup.izantech.app/schemas/json/implementation-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changes_made", "issues_encountered"],
  "properties": {
    "status": {
      "const": "complete"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changes_made": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "description", "task_id"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issues_encountered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue"],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string"
          },
          "impact": {
            "enum": ["none", "minor", "moderate", "significant"]
          }
        }
      }
    }
  }
}
