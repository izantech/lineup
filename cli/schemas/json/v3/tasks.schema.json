{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineup.izantech.app/schemas/json/v3/tasks.schema.json",
  "title": "Lineup v3 Tasks",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "tasks"],
  "properties": {
    "apiVersion": {
      "const": "lineup/v3"
    },
    "kind": {
      "const": "Tasks"
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1
    },
    "git_tree_sha": {
      "type": "string",
      "minLength": 1
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "wave", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "wave": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "blocked", "done"]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "agent": {
            "type": "string",
            "enum": ["researcher", "architect", "developer", "reviewer", "documenter", "teacher"]
          },
          "read_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
