{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineup.izantech.app/schemas/json/v3/pipeline-state.schema.json",
  "title": "Lineup v3 Pipeline State",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "run_id", "status", "artifact_hashes", "updated_at"],
  "properties": {
    "apiVersion": {
      "const": "lineup/v3"
    },
    "kind": {
      "const": "PipelineState"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "blocked", "succeeded", "failed", "canceled"]
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "task_prompt": {
      "type": "string"
    },
    "execution_host": {
      "type": "string",
      "enum": ["claude", "codex", "opencode", "ollama"]
    },
    "runner_host": {
      "type": "string",
      "enum": ["claude", "codex", "opencode"]
    },
    "force_ollama_backend": {
      "type": "boolean"
    },
    "ollama_model": {
      "type": "string",
      "minLength": 1
    },
    "gate_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "git_tree_sha": {
      "type": "string",
      "minLength": 1
    },
    "current_stage": {
      "type": "string",
      "minLength": 1
    },
    "completed_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constitution": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_at", "approved_by"],
      "properties": {
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "updated_at"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "running", "succeeded", "failed", "blocked"]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_message": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "pending_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "stage_id", "gate_type", "question", "choices", "created_at"],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_type": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default_choice": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "retry_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "attempt", "max_attempts", "last_attempt_at"],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "last_error": {
            "type": "string"
          },
          "last_attempt_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {}
        }
      }
    }
  }
}
