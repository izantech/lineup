{
  "name": "@izantech/lineup-cli",
  "version": "3.0.0",
  "private": false,
  "description": "Lineup native multi-host pipeline CLI for Claude Code, Codex, and OpenCode",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/izantech/lineup"
  },
  "homepage": "https://lineup.izantech.app",
  "bugs": {
    "url": "https://github.com/izantech/lineup/issues"
  },
  "keywords": [
    "lineup",
    "cli",
    "claude",
    "codex",
    "opencode",
    "agentic"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "lineup": "bin/lineup.mjs"
  },
  "files": [
    "dist",
    "bin",
    "agents",
    "tactics",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts src/index.ts --format esm --target node20 --out-dir dist --clean --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema:check": "tsx src/scripts/schema-check.ts",
    "generate:check": "tsx src/scripts/generate-check.ts",
    "smoke:dist": "tsx src/scripts/smoke-dist.ts",
    "smoke:ollama-hosts": "tsx src/scripts/smoke-ollama-hosts.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "rollup": "^4.60.1"
  }
}
